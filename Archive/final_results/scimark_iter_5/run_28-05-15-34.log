package jnt.scimark2;

import java.util.concurrent.ForkJoinPool;
import java.util.concurrent.RecursiveTask;

public class MonteCarloOptimized {
    public static void main(String[] args) {
        int cycles = 1073741824;
        double result = integrate(cycles);
        System.out.println(result);
    } 

    public static double integrate(long numSamples) {
        ForkJoinPool customThreadPool = new ForkJoinPool();
        try {
            MonteCarloTask task = new MonteCarloTask(0, (int) numSamples);
            long underCurve = customThreadPool.invoke(task);
            return ((double) underCurve / numSamples) * 4.0;
        } finally {
            customThreadPool.shutdown();
        }
    }

    static class MonteCarloOptimized extends RecursiveTask<Long> {
        private static final int THRESHOLD = 10000;
        private final int start, end;

        public MonteCarloTask(int start, int end) {
            this.start = start;
            this.end = end;
        }

        @Override
        protected Long compute() {
            if (end - start <= THRESHOLD) {
                long underCurve = 0;
                for (int i = start; i < end; i++) {
                    double x = Math.random();
                    double y = Math.random();
                    if (x * x + y * y <= 1.0) {
                        underCurve++;
                    }
                }
                return underCurve;
            } else {
                int mid = start + (end - start) / 2;
                MonteCarloTask leftTask = new MonteCarloTask(start, mid);
                MonteCarloTask rightTask = new MonteCarloTask(mid, end);
                leftTask.fork();
                long rightResult = rightTask.compute();
                long leftResult = leftTask.join();
                return leftResult + rightResult;
            }
        }
    }
}


