Original code to optimize:
package jnt.scimark2;

import java.util.Random;
import java.util.stream.IntStream;

public class LUOptimized {
    private final double[][] LU_;
    private final int[] pivot_;

    public static void main(String[] args) {
        Random R = new Random(101010);
        int N = 1000;

        double[][] A = RandomMatrix(N, N, R);
        double[][] lu = new double[N][N];
        int[] pivot = new int[N];

        CopyMatrix(lu, A);

        int status = factor(lu, pivot);
        if (status != 0) {
            System.err.println("LU factorization failed due to singular matrix.");
            return;
        }

        double[] b = RandomVector(N, R);
        double[] x = b.clone();

        solve(lu, pivot, x);
        System.out.println(normabs(b, matvec(A, x)) / N);
    }

    public LUOptimized(double[][] A) {
        int M = A.length;
        int N = A[0].length;

        LU_ = new double[M][N];

        insert_copy(LU_, A);

        pivot_ = new int[M];

        factor(LU_, pivot_);
    }

    private static double[][] RandomMatrix(int M, int N, Random R) {
        double[][] A = new double[M][N];
        IntStream.range(0, M).parallel().forEach(i -> {
            for (int j = 0; j < N; j++) {
                A[i][j] = R.nextDouble();
            }
        });
        return A;
    }

    private static double[] RandomVector(int N, Random R) {
        return IntStream.range(0, N).parallel().mapToDouble(i -> R.nextDouble()).toArray();
    }

    private static double[] matvec(double[][] A, double[] x) {
        int N = x.length;
        double[] y = new double[N];

        for (int i = 0; i < A.length; i++) {
            double sum = 0.0;
            for (int j = 0; j < N; j++) {
                sum += A[i][j] * x[j];
            }
            y[i] = sum;
        }

        return y;
    }

    private static double normabs(double[] x, double[] y) {
        return IntStream.range(0, x.length).parallel().mapToDouble(i -> Math.abs(x[i] - y[i])).sum();
    }

    private static void CopyMatrix(double[][] B, double[][] A) {
        for (int i = 0; i < A.length; i++) {
            System.arraycopy(A[i], 0, B[i], 0, A[i].length);
        }
    }

    protected static void insert_copy(double[][] B, double[][] A) {
        for (int i = 0; i < A.length; i++) {
            System.arraycopy(A[i], 0, B[i], 0, A[i].length);
        }
    }

    protected static double[][] new_copy(double[][] A) {
        double[][] T = new double[A.length][A[0].length];
        for (int i = 0; i < A.length; i++) {
            System.arraycopy(A[i], 0, T[i], 0, A[i].length);
        }
        return T;
    }

    public static int factor(double[][] A, int[] pivot) {
        int N = A.length;
        int M = A[0].length;

        int minMN = Math.min(M, N);

        for (int j = 0; j < minMN; j++) {
            int jp = j;

            double t = Math.abs(A[j][j]);
            for (int i = j + 1; i < M; i++) {
                double ab = Math.abs(A[i][j]);
                if (ab > t) {
                    jp = i;
                    t = ab;
                }
            }

            pivot[j] = jp;

            if (A[jp][j] == 0) return 1;

            if (jp != j) {
                double[] tA = A[j];
                A[j] = A[jp];
                A[jp] = tA;
            }

            if (j < M - 1) {
                double recp = 1.0 / A[j][j];

                for (int k = j + 1; k < M; k++)
                    A[k][j] *= recp;
            }

            if (j < minMN - 1) {
                for (int ii = j + 1; ii < M; ii++) {
                    double[] Aii = A[ii];
                    double[] Aj = A[j];
                    double AiiJ = Aii[j];
                    for (int jj = j + 1; jj < N; jj++)
                        Aii[jj] -= AiiJ * Aj[jj];
                }
            }
        }

        return 0;
    }

    public static void solve(double[][] LU, int[] pvt, double[] b) {
        int N = LU.length;

        for (int i = 0; i < N; i++) {
            int ip = pvt[i];
            double sum = b[ip];
            b[ip] = b[i];
            for (int j = 0; j < i; j++) {
                sum -= LU[i][j] * b[j];
            }
            b[i] = sum;
        }

        for (int i = N - 1; i >= 0; i--) {
            double sum = b[i];
            for (int j = i + 1; j < N; j++) {
                sum -= LU[i][j] * b[j];
            }
            b[i] = sum / LU[i][i];
        }
    }

    public double[][] getLU() {
        return new_copy(LU_);
    }

    public double[] solve(double[] b) {
        double[] x = b.clone();

        solve(LU_, pivot_, x);
        return x;
    }
