public static void executeBlocked(double omega, double[][] G, long num_iterations, int blockSize) {
    int M = G.length;
    int N = G[0].length;

    double omega_over_four = omega * 0.25;
    double one_minus_omega = 1.0 - omega;

    int Mm1 = M - 1;
    int Nm1 = N - 1;

    for (long p = 0; p < num_iterations; p++) {
        for (int ii = 1; ii < Mm1; ii += blockSize) {
            for (int jj = 1; jj < Nm1; jj += blockSize) {
