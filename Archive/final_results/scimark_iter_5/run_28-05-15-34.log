package jnt.scimark2;

import java.util.concurrent.ForkJoinPool;
import java.util.concurrent.RecursiveAction;
import java.util.concurrent.ThreadLocalRandom;

public class FFTOptimized {

    private static final ForkJoinPool pool = new ForkJoinPool();

    public static void transform(double[] data) {
        transform_internal(data, -1);
    }

    public static void inverse(double[] data) {
        transform_internal(data, +1);
        int nd = data.length;
        int n = nd / 2;
        double norm = 1.0 / n;
        for (int i = 0; i < nd; i += 2) {
            data[i] *= norm;
            data[i + 1] *= norm;
        }
    }

    public static double test(double[] data) {
        int nd = data.length;
        double[] copy = data.clone();
        transform(data);
        inverse(data);
        double diff = 0.0;
        for (int i = 0; i < nd; i++) {
            double d = data[i] - copy[i];
            diff += d * d;
        }
        return Math.sqrt(diff / nd);
    }

    public static double[] makeRandom(int n) {
        int nd = 2 * n;
        double[] data = new double[nd];
        for (int i = 0; i < nd; i++)
            data[i] = ThreadLocalRandom.current().nextDouble();
        return data;
    }

    public static void main(String[] args) {
        if (args.length == 0) {
            int n = 1048576;
            System.out.println(test(makeRandom(n)) / 1048576);
        }
        for (String arg : args) {
            int n = Integer.parseInt(arg);
            System.out.println(test(makeRandom(n)) / 1048576);
        }
    }

    protected static int log2(int n) {
        int log = 0;
        for (int k = 1; k < n; k *= 2, log++);
        if (n != (1 << log))
            throw new Error("FFT: Data length is not a power of 2!: " + n);
        return log;
    }

    protected static void transform_internal(double[] data, int direction) {
        if (data.length == 0) return;
        int n = data.length / 2;
        if (n == 1) return;
        int logn = log2(n);

        bitreverse(data);

        double[] cosTable = new double[n / 2];
        double[] sinTable = new double[n / 2];
        for (int i = 0; i < n / 2; i++) {
            double angle = 2 * Math.PI * i / n;
            cosTable[i] = Math.cos(angle);
            sinTable[i] = Math.sin(angle);
        }

        pool.invoke(new FFTTask(data, direction, cosTable, sinTable, logn));
    }

    private static class FFTOptimized extends RecursiveAction {
        private static final int THRESHOLD = 1 << 10;
        private final double[] data;
        private final int direction;
        private final double[] cosTable;
        private final double[] sinTable;
        private final int logn;

        FFTTask(double[] data, int direction, double[] cosTable, double[] sinTable, int logn) {
            this.data = data;
            this.direction = direction;
            this.cosTable = cosTable;
            this.sinTable = sinTable;
            this.logn = logn;
        }

        @Override
        protected void compute() {
            int n = data.length / 2;
            for (int bit = 0, dual = 1; bit < logn; bit++, dual *= 2) {
                if (dual < THRESHOLD) {
                    for (int b = 0; b < n; b += 2 * dual) {
                        for (int a = 0; a < dual; a++) {
                            int i = 2 * (b + a);
                            int j = 2 * (b + a + dual);

                            double z1_real = data[j];
                            double z1_imag = data[j + 1];

                            double wd_real = cosTable[a * (n / (2 * dual))] * z1_real - sinTable[a * (n / (2 * dual))] * z1_imag;
                            double wd_imag = cosTable[a * (n / (2 * dual))] * z1_imag + sinTable[a * (n / (2 * dual))] * z1_real;

                            data[j] = data[i] - wd_real;
                            data[j + 1] = data[i + 1] - wd_imag;
                            data[i] += wd_real;
                            data[i + 1] += wd_imag;
                        }
                    }
                } else {
                    FFTTask left = new FFTTask(data, direction, cosTable, sinTable, logn);
                    FFTTask right = new FFTTask(data, direction, cosTable, sinTable, logn);
                    invokeAll(left, right);
                }
            }
        }
    }

    protected static void bitreverse(double[] data) {
        int n = data.length / 2;
        int nm1 = n - 1;
        int i = 0;
        int j = 0;
        for (; i < nm1; i++) {
            int ii = i << 1;
            int jj = j << 1;
            int k = n >> 1;

            if (i < j) {
                double tmp_real = data[ii];
                double tmp_imag = data[ii + 1];
                data[ii] = data[jj];
                data[ii + 1] = data[jj + 1];
                data[jj] = tmp_real;
                data[jj + 1] = tmp_imag;
            }

            while (k <= j) {
                j -= k;
                k >>= 1;
            }
            j += k;
        }
    }
}

