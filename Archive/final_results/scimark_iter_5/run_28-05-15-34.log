                    sum2 += x[col[i + 1]] * val[i + 1];
                    sum3 += x[col[i + 2]] * val[i + 2];
                    sum4 += x[col[i + 3]] * val[i + 3];
                }
                for (; i < rowEnd; i++) {
                    sum1 += x[col[i]] * val[i];
                }
                y[r] = sum1 + sum2 + sum3 + sum4;
            }
        }
    }

    
    private static double[] randomVector(int N, Random R) {
        double[] A = new double[N];
        for (int i = 0; i < N; i++) {
            A[i] = R.nextDouble();
        }
        return A;
    }

    
