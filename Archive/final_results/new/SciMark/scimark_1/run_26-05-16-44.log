                            + one_minus_omega * Gi[j];
                    if (j + 1 < Nm1) {
                        Gi[j + 1] = omega_over_four * (Gim1[j + 1] + Gip1[j + 1] + Gi[j] + Gi[j + 2])
                                + one_minus_omega * Gi[j + 1];
                    }
