        int Mm1 = M - 1;
        int Nm1 = N - 1;
        for (long p = 0; p < num_iterations; p++) {
            for (int i = 1; i < Mm1; i++) {
                double[] Gi = G[i];
                double[] Gim1 = G[i - 1];
                double[] Gip1 = G[i + 1];
                for (int j = 1; j < Nm1; j++) {
                    Gi[j] = omega_over_four * (Gim1[j] + Gip1[j] + Gi[j - 1] + Gi[j + 1])
                            + one_minus_omega * Gi[j];
                }
            }
        }
    }

    // Helper method to generate a random matrix with dimensions M x N.
