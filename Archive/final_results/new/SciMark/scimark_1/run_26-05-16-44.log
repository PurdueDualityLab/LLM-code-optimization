public static double integrate(long numSamples) {
    ForkJoinPool customThreadPool = new ForkJoinPool(Math.min(Runtime.getRuntime().availableProcessors(), (int) (numSamples / 1000000L)));
    try {
        long underCurve = customThreadPool.submit(() ->
            LongStream.range(0, numSamples)
                .parallel()
                .mapToLong(i -> {
                    double x = ThreadLocalRandom.current().nextDouble();
                    double y = ThreadLocalRandom.current().nextDouble();
                    return (x * x + y * y <= 1.0) ? 1L : 0L;
                })
                .reduce(0L, Long::sum)
        ).get();

        return ((double) underCurve / numSamples) * 4.0;
    } catch (InterruptedException | ExecutionException e) {
        e.printStackTrace();
        return 0;
    } finally {
        customThreadPool.shutdown();
    }
}
```

- This version manages the parallelism more explicitly and reduces overhead from boxing operations by using `mapToLong` and `reduce`.

