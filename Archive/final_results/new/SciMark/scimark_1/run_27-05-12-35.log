package jnt.scimark2;

import java.util.concurrent.ForkJoinPool;
import java.util.concurrent.RecursiveTask;
import java.util.concurrent.ThreadLocalRandom;

public class MonteCarloOptimized {
    private static final int NUM_THREADS = Runtime.getRuntime().availableProcessors();

    public static void main(String[] args) {
        int cycles = 1073741824;
        double result = integrate(cycles);
        System.out.println(result);
    }

    public static double integrate(long numSamples) {
        ForkJoinPool pool = new ForkJoinPool(NUM_THREADS);
        long underCurve = pool.invoke(new MonteCarloTask(0, numSamples));
        pool.shutdown();
        return ((double) underCurve / numSamples) * 4.0;
    }

    private static class MonteCarloOptimized extends RecursiveTask<Long> {
        private static final long THRESHOLD = 1000000;
        private final long start;
        private final long end;

        public MonteCarloTask(long start, long end) {
            this.start = start;
            this.end = end;
        }

        @Override
        protected Long compute() {
            if (end - start <= THRESHOLD) {
                return computeDirectly();
            } else {
                long mid = start + (end - start) / 2;
                MonteCarloTask left = new MonteCarloTask(start, mid);
                MonteCarloTask right = new MonteCarloTask(mid, end);
                left.fork();
                long rightResult = right.compute();
                long leftResult = left.join();
                return leftResult + rightResult;
            }
        }

        private Long computeDirectly() {
            long underCurve = 0;
            for (long count = start; count < end; count++) {
                double x = ThreadLocalRandom.current().nextDouble();
                double y = ThreadLocalRandom.current().nextDouble();
                if (x * x + y * y <= 1.0) {
                    underCurve++;
                }
            }
            return underCurve;
        }
    }
}






