```java
import java.util.concurrent.ForkJoinPool;
import java.util.concurrent.RecursiveTask;

public class MonteCarloOptimized {
    private static final int SEED = 113;
    private static final Random R = new Random(SEED);

    public static void main(String[] args) {
        int cycles = 1073741824;
        ForkJoinPool forkJoinPool = new ForkJoinPool();
        double result = forkJoinPool.invoke(new MonteCarloTask(0, cycles));
        System.out.println(result);
    }

    static class MonteCarloTask extends RecursiveTask<Double> {
        private static final int THRESHOLD = 1000000; // Adjust this to balance load
        private final long start;
        private final long end;

        MonteCarloTask(long start, long end) {
            this.start = start;
            this.end = end;
        }

        @Override
        protected Double compute() {
            if (end - start <= THRESHOLD) {
                long underCurve = 0;
                for (long i = start; i < end; i++) {
                    double x = R.nextDouble();
                    double y = R.nextDouble();
                    if (x * x + y * y <= 1.0) {
                        underCurve++;
                    }
                }
                return ((double) underCurve / (end - start)) * 4.0;
            } else {
                long mid = start + (end - start) / 2;
                MonteCarloTask leftTask = new MonteCarloTask(start, mid);
                MonteCarloTask rightTask = new MonteCarloTask(mid, end);
                leftTask.fork();
                double rightResult = rightTask.compute();
                double leftResult = leftTask.join();
                return leftResult + rightResult;
            }
        }
    }
}
```

