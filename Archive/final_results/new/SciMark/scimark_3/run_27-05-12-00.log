Code After Optimization:
// Struct of Arrays (SoA) - Better Cache Utilization
typedef struct {
    float *x;
    float *y;
    float *z;
} PointArray;

void process_points(PointArray *points, int n) {
    for (int i = 0; i < n; i++) {
        //Accessing points->x[i] only loads x values, avoiding unnecessary y and z loads.
        points->x[i] *= 2.0f;
    }
    for (int i = 0; i < n; i++) {
        points->y[i] *= 2.0f;
    }
    for (int i = 0; i < n; i++) {
        points->z[i] *= 2.0f;
    }
}
