package jnt.scimark2;

import java.util.concurrent.ThreadLocalRandom;

public class MonteCarloOptimized {
    final static int SEED = 113;

    public static void main(String[] args) {
        long cycles = 1073741824L;
        double result = integrate(cycles);
        System.out.println(result);
    }

    public static double integrate(long Num_samples) {
        long under_curve1 = 0;
        long under_curve2 = 0;
        long under_curve3 = 0;
        long under_curve4 = 0;

        for (long count = 0; count < Num_samples; count += 4) {
            double x1 = ThreadLocalRandom.current().nextDouble();
            double y1 = ThreadLocalRandom.current().nextDouble();
            double x2 = ThreadLocalRandom.current().nextDouble();
            double y2 = ThreadLocalRandom.current().nextDouble();
            double x3 = ThreadLocalRandom.current().nextDouble();
            double y3 = ThreadLocalRandom.current().nextDouble();
            double x4 = ThreadLocalRandom.current().nextDouble();
            double y4 = ThreadLocalRandom.current().nextDouble();

            if (x1 * x1 + y1 * y1 <= 1.0) under_curve1++;
            if (x2 * x2 + y2 * y2 <= 1.0) under_curve2++;
            if (x3 * x3 + y3 * y3 <= 1.0) under_curve3++;
            if (x4 * x4 + y4 * y4 <= 1.0) under_curve4++;
        }

        long total_under_curve = under_curve1 + under_curve2 + under_curve3 + under_curve4;
        return ((double) total_under_curve / Num_samples) * 4.0;
    }
}


