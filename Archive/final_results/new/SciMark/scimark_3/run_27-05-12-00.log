package jnt.scimark2;

import java.util.concurrent.RecursiveAction;
import java.util.concurrent.ForkJoinPool;

public class FFTOptimized {

    private static ForkJoinPool pool = new ForkJoinPool();

    public static void transform(double[] data) {
        transform_internal(data, -1);
    }

    public static void inverse(double[] data) {
        transform_internal(data, +1);
        int nd = data.length;
        int n = nd / 2;
        double norm = 1 / ((double) n);
        for (int i = 0; i < nd; i++)
            data[i] *= norm;
    }

    public static double test(double[] data) {
        int nd = data.length;
        double[] copy = data.clone();
        transform(data);
        inverse(data);
        double diff = 0.0;
        for (int i = 0; i < nd; i++) {
            double d = data[i] - copy[i];
            diff += d * d;
        }
        return Math.sqrt(diff / nd);
    }

    public static double[] makeRandom(int n) {
        int nd = 2 * n;
        double[] data = new double[nd];
        for (int i = 0; i < nd; i++)
            data[i] = Math.random();
        return data;
    }

    public static void main(String[] args) {
        if (args.length == 0) {
            int n = 1048576;
            System.out.println(test(makeRandom(n)) / 1048576);
        }
        for (int i = 0; i < args.length; i++) {
            int n = Integer.parseInt(args[i]);
            System.out.println(test(makeRandom(n)) / 1048576);
        }
    }

    protected static int log2(int n) {
        int log = 0;
        for (int k = 1; k < n; k *= 2, log++) ;
        if (n != (1 << log))
            throw new Error("FFT: Data length is not a power of 2!: " + n);
        return log;
    }

    protected static void transform_internal(double[] data, int direction) {
        if (data.length == 0) return;
        int n = data.length / 2;
        if (n == 1) return;
        int logn = log2(n);

        double[] sinTable = new double[n];
        double[] cosTable = new double[n];
        precomputeTrigValues(logn, direction, sinTable, cosTable);
        bitreverse(data);

        pool.invoke(new FFTTask(data, direction, sinTable, cosTable, logn, 0, n, 1));
    }

    private static void precomputeTrigValues(int logn, int direction, double[] sinTable, double[] cosTable) {
        for (int i = 0; i < sinTable.length; i++) {
            double angle = 2.0 * direction * Math.PI * i / sinTable.length;
            sinTable[i] = Math.sin(angle);
            cosTable[i] = Math.cos(angle);
        }
    }

    protected static void bitreverse(double[] data) {
        int n = data.length / 2;
        int nm1 = n - 1;
        int i = 0;
        int j = 0;
        for (; i < nm1; i++) {
            int ii = i << 1;
            int jj = j << 1;
            int k = n >> 1;
            if (i < j) {
                double tmp_real = data[ii];
                double tmp_imag = data[ii + 1];
                data[ii] = data[jj];
                data[ii + 1] = data[jj + 1];
                data[jj] = tmp_real;
                data[jj + 1] = tmp_imag;
            }

            while (k <= j) {
                j -= k;
                k >>= 1;
            }
            j += k;
        }
    }

    private static class FFTOptimized extends RecursiveAction {
        private final double[] data;
        private final int direction;
        private final double[] sinTable;
        private final double[] cosTable;
        private final int logn;
        private final int start;
        private final int n;
        private final int dual;

        FFTTask(double[] data, int direction, double[] sinTable, double[] cosTable, int logn, int start, int n, int dual) {
            this.data = data;
            this.direction = direction;
            this.sinTable = sinTable;
            this.cosTable = cosTable;
            this.logn = logn;
            this.start = start;
            this.n = n;
            this.dual = dual;
        }

        @Override
        protected void compute() {
            if (dual < n) {
                int step = dual * 2;
                FFTTask left = new FFTTask(data, direction, sinTable, cosTable, logn, start, n, step);
                FFTTask right = new FFTTask(data, direction, sinTable, cosTable, logn, start + dual, n, step);
                invokeAll(left, right);
            } else {
                for (int a = 0; a < dual; a++) {
                    double w_real = 1.0;
                    double w_imag = 0.0;

                    for (int b = start; b < n; b += 2 * dual) {
                        int i = 2 * (b + a);
                        int j = 2 * (b + a + dual);

                        double z1_real = data[j];
                        double z1_imag = data[j + 1];

                        double wd_real = w_real * z1_real - w_imag * z1_imag;
                        double wd_imag = w_real * z1_imag + w_imag * z1_real;

                        data[j] = data[i] - wd_real;
                        data[j + 1] = data[i + 1] - wd_imag;
