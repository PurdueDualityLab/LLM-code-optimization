    import java.util.concurrent.*;

    public static double integrate(long Num_samples) {
        int numThreads = Runtime.getRuntime().availableProcessors();
        ExecutorService executor = Executors.newFixedThreadPool(numThreads);
        List<Future<Long>> futures = new ArrayList<>();

        long samplesPerThread = Num_samples / numThreads;

        for (int i = 0; i < numThreads; i++) {
            futures.add(executor.submit(() -> {
                Random R = new Random(SEED + Thread.currentThread().getId());
                long countUnderCurve = 0;
                for (long j = 0; j < samplesPerThread; j++) {
                    double x = R.nextDouble();
                    double y = R.nextDouble();
                    if (x * x + y * y <= 1.0) countUnderCurve++;
