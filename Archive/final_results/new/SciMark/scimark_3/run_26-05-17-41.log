Code Before Optimization:
int find_gcf(int a, int b)
{
    /* assumes both a and b are greater than 0*/
    while (1) {
        a = a % b;
        if (a == 0) return b;
        if (a == 1) return 1;

        b = b % a;
        if (b == 0) return a;
        if (b == 1) return 1;
    }
}

Code After Optimization:
int find_gcf(int a, int b)
{
    /* assumes both a and b are greater than 0 */
    while (1) {
        if (a > b) a = a - b;
        else if (a < b) b = b - a;
        else return a;
    }
}


