import java.util.concurrent.ForkJoinPool;
import java.util.concurrent.RecursiveAction;

public class FFTParallel {
    private static class FFTTask extends RecursiveAction {
        private final double[] data;
        private final int start, end, direction;

        FFTTask(double[] data, int start, int end, int direction) {
            this.data = data;
            this.start = start;
            this.end = end;
            this.direction = direction;
        }

        @Override
        protected void compute() {
            if (end - start <= THRESHOLD) {
                FFTOptimized.transform_internal(data, direction);
            } else {
                int mid = (start + end) / 2;
                FFTTask left = new FFTTask(data, start, mid, direction);
                FFTTask right = new FFTTask(data, mid, end, direction);
                invokeAll(left, right);
            }
        }
    }

    public static void parallelTransform(double[] data, int direction) {
        ForkJoinPool pool = new ForkJoinPool();
        FFTTask task = new FFTTask(data, 0, data.length, direction);
        pool.invoke(task);
    }
}
