```java
public static double integrate(long numSamples) {
    SplittableRandom random = new SplittableRandom();
    long underCurve = LongStream.range(0, numSamples)
        .parallel()
        .filter(i -> {
            double x = random.nextDouble();
            double y = random.nextDouble();
